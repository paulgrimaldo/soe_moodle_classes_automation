ACADEMIC_DATA_DIR=./data
ACADEMIC_DATABASE_URL=sqlite:///./data/academic.sqlite3
# Generate TWO independent values: openssl rand -hex 32
ACADEMIC_ADMIN_TOKEN=
ACADEMIC_N8N_TOKEN=
ACADEMIC_AUTH_ENABLED=true
ACADEMIC_MOODLE_URL=https://soe.uagrm.edu.bo/virtual/my/courses.php
ACADEMIC_MOODLE_SELECTORS_FILE=./config/moodle-selectors.json
ACADEMIC_TRANSCRIPT_SCRIPT=./scripts/yt_transcripts.sh
ACADEMIC_TRANSCRIPT_TIMEOUT=900
ACADEMIC_CODEX_TIMEOUT=1800
# Empty uses Codex account default, never forces a model.
ACADEMIC_CODEX_MODEL=
ACADEMIC_SKILL_PATH=~/.agents/skills/academic-transcription-to-notion
ACADEMIC_NOTION_TOKEN=
ACADEMIC_NOTION_VERSION=2026-03-11
# Optional existing DCC/MIA ancestor pages, used only for unambiguous lookup.
ACADEMIC_NOTION_DCC_ROOT=
ACADEMIC_NOTION_MIA_ROOT=
# Publication requires this switch AND explicit publish request, or auto_publish per module.
ACADEMIC_PUBLICATION_ENABLED=false
ACADEMIC_API_URL=http://127.0.0.1:8000
BACKEND_URL=http://host.docker.internal:8000
N8N_BACKEND_TOKEN=
N8N_ENCRYPTION_KEY=
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.0.0
